rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. [공개 읽기 허용] 누구나 볼 수 있어야 하는 데이터
    // 강좌, 시험, 카테고리, 선생님 목록, 웹 설정, 퀴즈, 후기, FAQ 등
    match /courses/{document=**} { allow read: if true; allow write: if request.auth != null; }
    match /exams/{document=**} { allow read: if true; allow write: if request.auth != null; }
    match /categories/{document=**} { allow read: if true; allow write: if request.auth != null; }
    match /teachers/{document=**} { allow read: if true; allow write: if request.auth != null; }
    match /web_store_config/{document=**} { allow read: if true; allow write: if request.auth != null; }
    match /web_landing_config/{document=**} { allow read: if true; allow write: if request.auth != null; }
    match /web_exam_landings/{document=**} { allow read: if true; allow write: if request.auth != null; }
    match /web_exam_details/{document=**} { allow read: if true; allow write: if request.auth != null; }
    match /testimonials/{document=**} { allow read: if true; allow write: if request.auth != null; }
    match /faqs/{document=**} { allow read: if true; allow write: if request.auth != null; }
    match /daily_quizzes/{document=**} { allow read: if true; allow write: if request.auth != null; }
    match /settings/{document=**} { allow read: if true; allow write: if request.auth != null; }
    match /system/{document=**} { allow read: if true; allow write: if request.auth != null; }

    // 2. [제출 허용] 로그인 없이 데이터를 '생성(Create)'만 가능한 곳
    // 레벨테스트 결과, 수강 신청서, 시험 접수
    // 주의: create는 허용하되, read/update/delete는 관리자만 가능해야 개인정보가 보호됨
    match /placement_results/{document=**} {
      allow create: if true; 
      allow read, update, delete: if request.auth != null;
    }
    match /students/{document=**} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
    match /exam_registrations/{document=**} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
    
    // 추가된 공개 제출 폼
    match /try_emma_leads/{document=**} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
    match /speaking_progress/{document=**} {
      allow create, update: if true; 
      allow read, delete: if request.auth != null;
    }

    // --- Mock Test System Rules (Incognito/Public Access) ---

    // 1. Mock Tests (Questions)
    // Students must be able to READ the test content to take the exam.
    // Admins (authenticated) can manage them.
    match /mock_tests/{testId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 2. Mock Test Tickets
    // Students must be able to READ (validate code) and UPDATE (save progress).
    // Security relies on the Ticket ID being a secret key.
    match /mock_test_tickets/{ticketId} {
      allow read, update: if true;
      allow create, delete: if request.auth != null;
    }

    // 3. Mock Test Results
    // Students CREATE a result upon completion.
    // They cannot read others' results. Admins can view all.
    match /mock_test_results/{resultId} {
      allow create: if true;
      allow get: if true; // Allow students to view their own result by ID
      allow list: if request.auth != null; // Only admins can list all results
      allow update, delete: if request.auth != null;
    }

    // 3. [관리자 전용] 나머지는 로그인한 관리자만 접근 가능
    // 출석부, 수업 세션, 재정 데이터, 유저 목록 등
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
